[Unit]
Description=hearth chat (Aider) + Qwen
After=network.target hearth-qwen.service

[Service]
Type=simple
WorkingDirectory=@WORKSPACE@
Environment=PYTHONPATH=@PREFIX@
Environment=HEARTH_WORKSPACE=@WORKSPACE@
Environment=HEARTH_PORT=@PORT@
Environment=HEARTH_LLAMA_HOST=127.0.0.1
Environment=HEARTH_LLAMA_PORT=@LLAMA_PORT@
Environment=HEARTH_MODEL=qwen
Environment=OPENAI_API_BASE=http://127.0.0.1:@LLAMA_PORT@/v1
Environment=OPENAI_API_KEY=local
Environment=NO_COLOR=1
Environment=AIDER_ANALYTICS=false
ExecStart=@AIDER_PY@ -m hearth
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
